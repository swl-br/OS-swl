; ptr_arith.swl -- scaled pointer arithmetic and sizeof
module main

struct Pair
    a: i32
    b: i32
end

fn main() -> i32
    var buf: [i32, 4]
    var p: *i32 = buf
    *p = 10
    p = p + 1
    *p = 20
    p = p + 1
    *p = 30
    p = buf

    swl_print_i32(*p)        ; 10
    swl_print_i32(*(p + 2))  ; 30 (offset scaled by sizeof(i32))
    p = p + 2
    swl_print_i32(*p)        ; 30

    var msg: [u8, 8] = "hi abc"
    var q: *u8 = msg
    q = q + 1
    swl_putchar(*q as i32)   ; prints 'i'

    swl_print_i32(sizeof(i32))      ; 4
    swl_print_i32(sizeof(*i32))     ; 4
    swl_print_i32(sizeof(u8))       ; 1
    swl_print_i32(sizeof([i32, 4])) ; 16
    swl_print_i32(sizeof(Pair))     ; 8

    var r: *i32 = (p as i32) as *i32 ; reinterpret round-trip
    swl_print_i32(*r)               ; 30
    return 0
end
