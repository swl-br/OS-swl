; struct_param.swl -- struct by value: parameters, return, nesting
module main

struct Point
    x: i32
    y: i32
end

fn make_point(x: i32, y: i32) -> Point
    var p: Point
    p.x = x
    p.y = y
    return p
end

fn add_points(a: Point, b: Point) -> Point
    var result: Point
    result.x = a.x + b.x
    result.y = a.y + b.y
    return result
end

fn main() -> i32
    var p1: Point = make_point(10, 20)
    var p2: Point = make_point(30, 40)
    var sum: Point = add_points(p1, p2)
    ; sum = (40, 60) -> 40 + 60 = 100
    return sum.x + sum.y
end
