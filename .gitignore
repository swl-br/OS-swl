# Saídas de build (reproduzíveis via Makefile/scripts)
/build/
*.img
*.cpio.gz
*.bin
*.o
*.log

# Árvores geradas/volumosas (reproduzíveis via scripts/ e userland/):
# kernel vem via userland/fetch-deps.sh + kernel/config/swl_defconfig
# (não commitar a árvore de ~1.4GB); rootfs/ e gui-artifacts/ são
# remontados pelos scripts de empacotamento a cada build.
/rootfs/
/gui-artifacts/
/kernel/*
!/kernel/config/

# Build dirs do Meson (host-arch, nunca sobem — o guest compila no chroot)
/apps/*/build/
/swl-ui/build/

# Editor/SO
*.swp
*~
.DS_Store

# Caixa de entrada local p/ revisão (só nesta máquina, não sobe)
/revisao-de-entrada_LOCAL/
