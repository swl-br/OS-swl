#!/bin/sh
# swlfetch v5 — infos + Neo; auto-ajusta à largura do terminal (T4)
#
# Layouts:
#   largo  (≥ info+gap+arte): lado a lado
#   médio  : encolhe coluna de info
#   estreito (< arte+8)     : info em cima, arte embaixo

# Arte: junto do script, /usr/share/swl, ou CWD (dev)
_ART_CAND1="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/neo-face.txt"
_ART_CAND2="/usr/share/swl/neo-face.txt"
_ART_CAND3="./neo-face.txt"
if [ -f "$_ART_CAND1" ]; then ART="$_ART_CAND1"
elif [ -f "$_ART_CAND2" ]; then ART="$_ART_CAND2"
elif [ -f "$_ART_CAND3" ]; then ART="$_ART_CAND3"
else ART=""
fi

# Gato desativado por enquanto (usuário achou feio; volta quando o Neo
# ficar bom — ver T3). Com ART vazio o layout cai em "info".
ART=""

esc=$(printf '\033')
C="${esc}[36m"; G="${esc}[32m"; N="${esc}[0m"

MT=$(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo 2>/dev/null)
MA=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo 2>/dev/null)
UP=$(cut -d. -f1 /proc/uptime 2>/dev/null | awk '{printf "%02d:%02d:%02d", $1/3600, ($1%3600)/60, $1%60}')
KR=$(uname -r 2>/dev/null)

# Largura do terminal
cols=
if [ -n "$COLUMNS" ]; then
  cols=$COLUMNS
elif stty size >/dev/null 2>&1; then
  cols=$(stty size 2>/dev/null | awk '{print $2}')
elif [ -r /dev/tty ] && stty size </dev/tty >/dev/null 2>&1; then
  cols=$(stty size </dev/tty 2>/dev/null | awk '{print $2}')
fi
case $cols in
  ''|*[!0-9]*) cols=80 ;;
esac
[ "$cols" -lt 20 ] && cols=20

# Largura visual da arte (sem CSI) — neo atual = 40
# neo-face.txt é desenhado em 40 colunas de célula (glifos UTF-8
# multi-byte). Contar bytes no awk infla a largura — valor fixo.
ART_W=${SWL_ART_W:-40}

GAP=3
INFO_W=28
need=$((INFO_W + GAP + ART_W))

layout=side
if [ -z "$ART" ] || [ ! -f "$ART" ]; then
  layout=info
elif [ "$cols" -lt $((ART_W + 8)) ]; then
  layout=stack
elif [ "$cols" -lt "$need" ]; then
  layout=side
  INFO_W=$((cols - GAP - ART_W))
  [ "$INFO_W" -lt 16 ] && INFO_W=16
fi

padinfo() {
  _txt=$1
  _w=$2
  vis=$(printf '%s' "$_txt" | sed "s/${esc}\[[0-9;]*m//g")
  n=${#vis}
  printf '%s' "$_txt"
  while [ "$n" -lt "$_w" ]; do
    printf ' '
    n=$((n + 1))
  done
}

print_info_lines() {
  # imprime as 5 linhas de info (para stack ou side)
  printf '%s\n' "${C}SWL OS${N}  v1.0.0 x86 32bit"
  printf '%s\n' "Kernel:  $KR"
  printf '%s\n' "Shell:   SWL Shell"
  printf '%s\n' "Mem:     ${G}${MA}M${N} / ${MT}M"
  printf '%s\n' "Uptime:  $UP"
}

if [ "$layout" = "info" ]; then
  print_info_lines
  printf '\n'
  exit 0
fi

if [ "$layout" = "stack" ]; then
  print_info_lines
  printf '\n'
  # arte; se terminal ainda menor que ART_W, corta visualmente é difícil
  # com CSI — imprime inteira (usuário pode scrollar)
  cat "$ART"
  printf '\n'
  exit 0
fi

# layout=side — info alinhada + arte
i=0
while IFS= read -r line; do
  i=$((i + 1))
  case $i in
    6)  info="${C}SWL OS${N}  v1.0.0 x86 32bit" ;;
    7)  info="Kernel:  $KR" ;;
    8)  info="Shell:   SWL Shell" ;;
    9)  info="Mem:     ${G}${MA}M${N} / ${MT}M" ;;
    10) info="Uptime:  $UP" ;;
    *)  info="" ;;
  esac
  padinfo "$info" "$INFO_W"
  # gap
  g=0
  while [ "$g" -lt "$GAP" ]; do
    printf ' '
    g=$((g + 1))
  done
  printf '%s\n' "$line"
done < "$ART"
printf '\n'
