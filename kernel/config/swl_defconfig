# --- Otimização geral (build do kernel em si, não do userland estático) ---
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# --- Compressão de memória: sem HIGHMEM e em 32-bit, RAM é escassa —
#     zram cria um bloco de swap comprimido em RAM (não depende de ter
#     uma partição de swap real configurada, o que combina melhor com
#     um live/instalável simples) ---
CONFIG_ZRAM=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZPOOL=y
CONFIG_ZBUD=y
CONFIG_CRYPTO_LZO=y

# --- Endurecimento (hardening) que não quebra o boot nem exige chave
#     de assinatura de módulo (build continua simples) ---
